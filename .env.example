# Browser-safe Supabase configuration (required for authentication and live data)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-legacy-anon-key

# Development fixtures are off by default and cannot be enabled in production builds.
VITE_COS_ALLOW_DEMO=false

# Optional local Vite behavior
DISABLE_HMR=false

# Server-side scripts only. Never expose these through VITE_* variables.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=
COS_EXPECTED_SUPABASE_PROJECT_REF=your-project-ref
COS_SEED_CONFIRMATION=

# Staging-only bootstrap scripts. Store the server key only in local secret
# configuration; never commit its value.
COS_EXPECTED_STAGING_PROJECT_REF=your-staging-project-ref
COS_BOOTSTRAP_STAGING_CONFIRMATION=
COS_APP_ORIGIN=http://localhost:3000
COS_BOOTSTRAP_ADMIN_EMAIL=
COS_BOOTSTRAP_ADMIN_FIRST_NAME=
COS_BOOTSTRAP_ADMIN_LAST_NAME=
COS_BOOTSTRAP_ADMIN_JOB_TITLE=
COS_BOOTSTRAP_ADMIN_DEPARTMENT=
COS_BOOTSTRAP_CEO_EMAIL=
COS_BOOTSTRAP_CEO_FIRST_NAME=
COS_BOOTSTRAP_CEO_LAST_NAME=
COS_BOOTSTRAP_CEO_JOB_TITLE=
COS_BOOTSTRAP_CEO_DEPARTMENT=

# Edge Function secret/configuration (set in Supabase, not in a browser build)
COS_ALLOWED_ORIGINS=http://localhost:3000

# Optional controlled E2E account
COS_E2E_EMAIL=
COS_E2E_PASSWORD=
COS_CAPTURE=0
