# GEMINI_API_KEY: Required for Gemini AI API calls.
# COS-V1 automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the COS-V1 UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# APP_URL: The URL where this applet is hosted.
# COS-V1 automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=AQ.Ab8RN6IUq3ijViAhRgmcSRzn_AQl28PldgpY4A6rVQkYPUa0RQ


# Supabase environment variables for local development
# Copy this file to `.env.local` and replace the placeholder values.

# Vite runtime env used by the app
VITE_SUPABASE_URL=https://bppjneljqonuouleptgs.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_OA7CRonCDXeIMRQNdYd3Tg_-1QhjgnF

# Optional: used by the seed script (can be same as anon key, or use a service role key for full permissions)
SUPABASE_URL=https://bppjneljqonuouleptgsf.supabase.co
SUPABASE_KEY=sb_publishable_OA7CRonCDXeIMRQNdYd3Tg_-1QhjgnF

# Notes:
# - Do NOT commit your real keys into source control.
# - For local development, set the above values and restart the dev server.
